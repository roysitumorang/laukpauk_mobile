        android:name=".LaukpaukApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:enableOnBackInvokedCallback="true"
        tools:replace="android:allowBackup,android:supportsRtl"
        tools:targetApi="36">

        <!-- Android 16 (targetSdk 36): predictive back is on and onBackPressed() is never called; screens use
             BaseActivity.setOnBack(). Edge-to-edge cannot be opted out of; BaseActivity applies the insets.
             On screens >= 600dp Android 16 ignores the portrait lock below, so layouts must also work in landscape. -->

        <!-- Google Maps SDK key: MAPS_API_KEY in laukpauk.properties (never commit the real key) -->
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${MAPS_API_KEY}" />

