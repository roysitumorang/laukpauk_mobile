<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy ui/Header: delivery strip, search entry, cart and bell buttons with badges. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/green"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/deliveryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingTop="7.5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7.5dp"
            android:text="@string/home_header_diantarin"
            android:textColor="@color/nearly_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alamat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/nearly_white"
            android:paddingStart="15dp"
            android:paddingTop="7.5dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7.5dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/searchField"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:padding="16.5dp"
                android:src="@drawable/ic_search"
                app:tint="@color/nearly_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/home_header_cari_hint"
                android:textColor="@color/nearly_white"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="50.5dp"
            android:background="@color/nearly_white"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/cartButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_header_keranjang">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shopping_cart"
                    app:tint="@color/green" />

                <TextView
                    android:id="@+id/cartBadge"
                    style="@style/Home.Badge"
                    android:layout_gravity="top|end" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/bellButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_header_notifikasi">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/green" />

                <TextView
                    android:id="@+id/bellBadge"
                    style="@style/Home.Badge"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="5dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
