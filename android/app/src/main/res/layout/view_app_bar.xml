<?xml version="1.0" encoding="utf-8"?>
<!-- Shared green app bar of the detail screens (the Dart AppBar(backgroundColor: CustomColors.green) with a
     centred white title, iOS-style). Include it and call AppBars.setup(fragment, binding.appBar, title). -->
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/green"
    android:elevation="4dp"
    app:navigationIcon="@drawable/ic_arrow_back_ios"
    app:navigationIconTint="@android:color/white"
    app:titleCentered="true"
    app:titleTextColor="@android:color/white" />
