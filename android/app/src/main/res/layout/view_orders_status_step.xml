<?xml version="1.0" encoding="utf-8"?>
<!-- One step of StatusTransaksi: a round icon, the connector to the next step and an optional label. Sizes are set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/circle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_orders_circle">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/nearly_white"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </FrameLayout>

        <View
            android:id="@+id/line"
            android:layout_width="12dp"
            android:layout_height="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2.5dp"
        android:textColor="@color/orders_black87"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
