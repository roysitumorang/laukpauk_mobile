<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nearly_white"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="25dp"
    android:paddingEnd="15dp"
    android:paddingBottom="25dp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="187dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="71dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="71dp"
        android:gravity="center"
        android:text="@string/checkout_berhasil"
        android:textColor="@android:color/black"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBelanjaLagi"
            style="@style/Checkout.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkout_belanja_lagi" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetail"
            style="@style/Checkout.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/checkout_lihat_detail" />
    </LinearLayout>
</LinearLayout>
