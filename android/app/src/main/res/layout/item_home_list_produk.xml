<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="2.5dp" android:paddingEnd="2.5dp" android:paddingBottom="10dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="0dp"
        app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp" app:cardElevation="1dp"
        app:layout_constraintDimensionRatio="3:5" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground" android:orientation="vertical">
            <ImageView android:id="@+id/foto" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginBottom="15dp" android:layout_weight="1" android:importantForAccessibility="no" />
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/nama" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:ellipsize="end" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp"
                        android:textColor="@color/home_text" android:textSize="13sp" android:textStyle="bold" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="7.5dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                        <ProgressBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="15dp" />
                        <TextView android:id="@+id/tanpaHarga" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:text="@string/home_produk_tanpa_harga" android:textColor="@color/text_muted"
                            android:textSize="10sp" android:visibility="gone" />
                        <LinearLayout android:id="@+id/priceBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
                            <LinearLayout android:id="@+id/diskonRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:visibility="gone">
                                <TextView android:id="@+id/hargaCoret" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textColor="@color/home_text" android:textSize="11sp" />
                                <TextView android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp" android:background="@drawable/bg_home_pill_amber"
                                    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2.5dp" android:paddingBottom="2.5dp"
                                    android:textColor="@color/home_text" android:textSize="10sp" />
                            </LinearLayout>
                            <TextView android:id="@+id/harga" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="5dp" android:textColor="@color/green" android:textSize="12sp" android:textStyle="bold" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/beli" style="@style/Widget.Home.PillButton"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp"
                                android:text="@string/home_beli" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
