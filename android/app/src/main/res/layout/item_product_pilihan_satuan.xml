<?xml version="1.0" encoding="utf-8"?>
<!-- PilihanSatuanProdukItem.dart: a dense ListTile with a radio, title, subtitle and quantity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <RadioButton
        android:id="@+id/radio"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:buttonTint="@color/product_radio_checked"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:textColor="@color/dark_green"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/maxOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2.5dp"
            android:textColor="@color/product_black54"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quantityBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/product_black87"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_drop_down" />
    </LinearLayout>

    <TextView
        android:id="@+id/hargaPas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/product_harga_pas"
        android:textColor="@color/product_black87"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
