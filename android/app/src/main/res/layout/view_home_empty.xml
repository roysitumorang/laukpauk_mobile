<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical" android:padding="15dp">
    <ImageView android:layout_width="94dp" android:layout_height="wrap_content" android:adjustViewBounds="true"
        android:importantForAccessibility="no" android:src="@drawable/empty" />
    <TextView android:id="@+id/emptyText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_muted" android:textSize="13sp" />
</LinearLayout>
