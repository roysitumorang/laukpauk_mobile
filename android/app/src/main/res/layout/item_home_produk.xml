<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="131dp" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp"
    android:paddingStart="2.5dp" android:paddingEnd="2.5dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent"
        app:cardBackgroundColor="@color/nearly_white" app:cardCornerRadius="10dp" app:cardElevation="2dp">
        <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:id="@+id/foto" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:importantForAccessibility="no" android:scaleType="fitXY" />
                <TextView android:id="@+id/hemat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|end" android:layout_margin="5dp" android:background="@drawable/bg_home_pill_amber"
                    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2.5dp" android:paddingBottom="2.5dp"
                    android:textColor="@color/home_text" android:textSize="10sp" android:visibility="gone" />
                <TextView android:id="@+id/promo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|start" android:layout_margin="5dp" android:background="@drawable/bg_home_pill_danger"
                    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2.5dp" android:paddingBottom="2.5dp"
                    android:text="@string/home_promo" android:textColor="@color/nearly_white" android:textSize="10sp" android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ProgressBar android:id="@+id/progress" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" />
                <ScrollView android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="vertical"
                        android:paddingStart="7.5dp" android:paddingEnd="7.5dp" android:paddingTop="10dp">
                        <TextView android:id="@+id/nama" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:ellipsize="end" android:gravity="center" android:textColor="@color/home_text"
                            android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/toko" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:gravity="center" android:paddingBottom="7.5dp"
                            android:singleLine="true" android:ellipsize="marquee" android:textColor="@color/text_muted" android:textSize="10sp" />
                        <TextView android:id="@+id/deskripsi" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:ellipsize="end" android:gravity="center" android:maxLines="2" android:paddingBottom="7.5dp"
                            android:textColor="@color/text_muted" android:textSize="10sp" android:visibility="gone" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/harga" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/green" android:textSize="9sp" android:textStyle="bold" />
                            <TextView android:id="@+id/hargaCoret" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="5dp" android:textColor="@color/nearly_black" android:textSize="9sp"
                                android:textStyle="bold" android:visibility="gone" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/beli" style="@style/Widget.Home.PillButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:text="@string/home_beli" android:visibility="gone" />
                        <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:gravity="center" android:textSize="10sp" android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
