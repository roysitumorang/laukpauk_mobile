<?xml version="1.0" encoding="utf-8"?>
<!-- ProdukDiDalamPasarItem.dart: a product tile of the grid (image on top, text/price/Beli below).
     The adapter sets the root height from the grid cell aspect ratio. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="2.5dp"
        android:layout_marginEnd="2.5dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/nearly_white"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:rippleColor="@color/product_ripple">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/hemat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_product_pill_amber"
                    android:paddingStart="10dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2.5dp"
                    android:textColor="@color/product_black87"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/promo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_product_pill_danger"
                    android:paddingStart="10dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2.5dp"
                    android:text="@string/market_promo"
                    android:textColor="@color/nearly_white"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/textScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="7.5dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="7.5dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/nama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:textColor="@color/product_black87"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deskripsi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingBottom="7.5dp"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/priceRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingBottom="3.5dp">

                        <TextView
                            android:id="@+id/hargaBersih"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="@color/green"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hargaCoret"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:singleLine="true"
                            android:textColor="@color/nearly_black"
                            android:textSize="9sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/beli"
                        style="@style/ProductButton.Sm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:text="@string/product_beli" />

                    <TextView
                        android:id="@+id/noPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/market_tidak_ada_harga"
                        android:textColor="@color/nearly_black"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/stokHabis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/market_stok_habis"
                        android:textColor="@color/text_danger"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
