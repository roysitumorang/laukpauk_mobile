<?xml version="1.0" encoding="utf-8"?>
<!-- PasarLain.dart: the other markets, or a prompt to choose the delivery address first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/sections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/dalamCa"
            layout="@layout/view_market_pasar_lain_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />

        <include
            android:id="@+id/luarCa"
            layout="@layout/view_market_pasar_lain_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/adjdBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/adjdImage"
            android:layout_width="94dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="@string/market_adjd_belum_ditentukan"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adjdButton"
            style="@style/ProductButton.Sm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/market_tentukan_lokasi" />
    </LinearLayout>
</LinearLayout>
