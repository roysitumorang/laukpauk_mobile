<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nearly_white"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingTop="20dp"
            android:paddingEnd="15dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/seller_produk_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/seller_produk_text"
                android:textSize="11sp" />

            <FrameLayout
                android:id="@+id/fotoHolder"
                android:layout_width="match_parent"
                android:layout_height="187dp"
                android:layout_marginTop="15dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/seller_produk_foto">

                <ImageView
                    android:id="@+id/foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/fotoIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.35"
                    android:importantForAccessibility="no"
                    android:padding="37dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginBottom="5dp"
    android:text="@string/seller_produk_label_nama"
    android:textColor="@color/seller_produk_text"
    android:textSize="12sp"
    android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    android:hint="@string/seller_produk_hint_nama"
    style="@style/SellerProdukOutlinedField">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/nama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textSize="13sp" />
</com.google.android.material.textfield.TextInputLayout>

            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginBottom="5dp"
    android:text="@string/seller_produk_label_jenis"
    android:textColor="@color/seller_produk_text"
    android:textSize="12sp"
    android:textStyle="bold" />
            <Spinner
                android:id="@+id/jenis"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_seller_produk_outline" />

            <LinearLayout
                android:id="@+id/kategoriBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginBottom="5dp"
    android:text="@string/seller_produk_label_kategori"
    android:textColor="@color/seller_produk_text"
    android:textSize="12sp"
    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/kategori"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_seller_produk_outline" />
            </LinearLayout>

            <TextView
                android:id="@+id/noteHarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/seller_produk_note_harga"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/paketBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="5dp"
    android:text="@string/seller_produk_harga"
    android:textColor="@color/seller_produk_text"
    android:textSize="12sp"
    android:textStyle="bold" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SellerProdukOutlinedField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:prefixText="@string/seller_produk_rp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/harga"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="5dp"
    android:text="@string/seller_produk_diskon"
    android:textColor="@color/seller_produk_text"
    android:textSize="12sp"
    android:textStyle="bold" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SellerProdukOutlinedField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:prefixText="@string/seller_produk_rp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/diskon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginBottom="5dp"
    android:text="@string/seller_produk_label_keterangan"
    android:textColor="@color/seller_produk_text"
    android:textSize="12sp"
    android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    android:hint="@string/seller_produk_hint_keterangan"
    style="@style/SellerProdukOutlinedField">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/keterangan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textSize="13sp" />
</com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/simpan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/seller_produk_simpan_data"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
