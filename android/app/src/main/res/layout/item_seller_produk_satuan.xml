<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nomor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="@color/seller_produk_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/seller_produk_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_seller_produk_chip"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:textColor="@color/nearly_white"
                android:textSize="9sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/hargaEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/seller_produk_harga"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="@color/seller_produk_text"
            android:textColorHint="@color/seller_produk_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/diskonEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:hint="@string/seller_produk_diskon"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="@color/seller_produk_text"
            android:textColorHint="@color/seller_produk_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hargaText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/seller_produk_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/diskonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/seller_produk_text"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/edit"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_warning" />

            <ImageView
                android:id="@+id/hapus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_danger" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keteranganBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_seller_produk_keterangan"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/seller_produk_keterangan"
            android:textColor="@color/seller_produk_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keterangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="3dp"
            android:textColor="@color/seller_produk_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
