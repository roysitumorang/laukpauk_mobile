<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Legacy CustomButton(size sm, pill, themeColor): green pill, white 11sp label. -->
    <style name="Widget.Home.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">23dp</item>
        <item name="android:paddingEnd">23dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Home.SectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/home_text</item>
    </style>

    <style name="Home.SectionLink">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/dark_green</item>
    </style>

    <!-- Header cart / bell badge -->
    <style name="Home.Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:minWidth">17.5dp</item>
        <item name="android:minHeight">17.5dp</item>
        <item name="android:padding">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/bg_home_badge</item>
        <item name="android:textColor">@color/nearly_white</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="Home.WalletEntry">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="Home.WalletIcon">
        <item name="android:layout_width">19dp</item>
        <item name="android:layout_height">19dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Home.WalletText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Home.WalletTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Home.WalletValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">8sp</item>
    </style>
</resources>
