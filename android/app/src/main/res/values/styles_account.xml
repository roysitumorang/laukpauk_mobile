<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Legacy CustomButton: theme coloured, pill shaped (filled and outline variants) -->
    <style name="Widget.Account.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.Account.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/green</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.Account.Button.Info" parent="Widget.Account.Button.Outline">
        <item name="strokeColor">@color/account_info_button</item>
        <item name="android:textColor">@color/account_info_button</item>
    </style>

    <!-- Section title inside the cards -->
    <style name="Account.SectionTitle" parent="">
        <item name="android:textColor">@color/account_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Account.Caption" parent="">
        <item name="android:textColor">@color/nearly_black</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Account.FieldLabel" parent="">
        <item name="android:textColor">@color/account_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- CustomForm.textField with the green 1dp border -->
    <style name="Account.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/green</item>
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <style name="Account.Field.Password" parent="">
        <item name="endIconMode">password_toggle</item>
    </style>

    <!-- RequestJadiPenjual pill field: light green filled box with floating label -->
    <style name="Account.PillField" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/light_green</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
    </style>
</resources>
