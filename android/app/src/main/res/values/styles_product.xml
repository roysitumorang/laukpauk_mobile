<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Legacy CustomButton(pill, themeColor): green pill button. -->
    <style name="ProductButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/green</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="ProductButton.Sm">
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
    <style name="ProductButton.Xs">
        <item name="android:textSize">10sp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
</resources>
